/target

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local environment (NEVER commit tokens!)
.env
.env.local
token
*.token

# Vendored gh binary — NOT committed. Downloaded on first use via `codespacectl doctor`
# or auto-fetched when CODESPACECTL_GH_BIN is not set.
tools/bin/gh
tools/bin/gh-*

# scripts/bundle/ binaries ARE committed (pre-compiled for common sandbox targets).
# If you add a new binary, update scripts/bundle/MANIFEST.json and re-run
# scripts/update-bundle.sh to regenerate checksums.
